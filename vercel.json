{
  "redirects": [
    {
      "source": "/services",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/service-page/:path*",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/blank-3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/#gallery",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/valeting",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/mobile-car-detailing-luton",
      "destination": "/mobile-car-detailing-swindon",
      "permanent": true
    },
    {
      "source": "/car-detailing-bedford",
      "destination": "/car-detailing-marlborough",
      "permanent": true
    },
    {
      "source": "/car-detailing-dunstable",
      "destination": "/car-detailing-cirencester",
      "permanent": true
    },
    {
      "source": "/car-detailing-st-albans",
      "destination": "/car-detailing-chippenham",
      "permanent": true
    },
    {
      "source": "/car-detailing-hitchin",
      "destination": "/car-detailing-royal-wootton-bassett",
      "permanent": true
    },
    {
      "source": "/car-detailing-stevenage",
      "destination": "/car-detailing-bath",
      "permanent": true
    },
    {
      "source": "/car-detailing-hemel-hempstead",
      "destination": "/car-detailing-newbury",
      "permanent": true
    },
    {
      "source": "/car-detailing-watford",
      "destination": "/car-detailing-oxford",
      "permanent": true
    },
    {
      "source": "/car-detailing-milton-keynes",
      "destination": "/car-detailing-reading",
      "permanent": true
    },
    {
      "source": "/car-detailing-aylesbury",
      "destination": "/mobile-car-detailing-swindon",
      "permanent": true
    },
    {
      "source": "/car-detailing-london",
      "destination": "/mobile-car-detailing-swindon",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-and-conditions.html"
    },
    {
      "source": "/((?!assets|.*\\..*|_next).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    }
  ]
}
